# Template file for 'hyprpaper'
pkgname=hyprpaper
version=0.8.4
revision=1
build_style=cmake
hostmakedepends="pkgconf"
makedepends="
	hyprutils hyprgraphics hyprtoolkit hyprlang hyprwayland-scanner hyprwire wayland-protocols
	wayland-devel cairo-devel pango-devel libglvnd-devel xorgproto libdrm-devel file-devel
"
short_desc="Fast wallpaper utility for wlroots compositors with IPC controls"
maintainer="RotaryBoot58 <petersoncraft20@proton.me>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprpaper"
distfiles="https://github.com/hyprwm/hyprpaper/archive/refs/tags/v${version}.tar.gz"
checksum=4912c7aede303918f38a3fc6b294429e2d541b639ebba67bcab58d1d367ea360

pre_build() {
	# Replace C++23 append_range with C++20 compatible insert
	vsed -i 'src/config/WallpaperMatcher.cpp' -e 's/m_settings.append_range(std::move(s))/m_settings.insert(m_settings.end(), std::make_move_iterator(s.begin()), std::make_move_iterator(s.end()))/'
}

post_install() {
	vlicense LICENSE
}
